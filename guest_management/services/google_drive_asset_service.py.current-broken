"""
Google Drive service for EventLah.

This service authenticates Google Drive using the authenticated
EventLah user's encrypted Google OAuth refresh token stored in
the users table.

Authentication priority:

    1. Database OAuth refresh token
    2. Local OAuth token file (legacy compatibility)
    3. Service-account JSON file (legacy fallback)
    4. Service-account JSON environment variable

The database OAuth token is the preferred production mechanism.

The service does not modify application database records.
"""

from __future__ import annotations

import base64
import hashlib
import io
import json
import logging
import os
from pathlib import Path
from typing import Any, Dict, Optional

from cryptography.fernet import Fernet
from dotenv import load_dotenv

from google.auth.transport.requests import Request
from google.oauth2 import credentials as oauth_credentials
from google.oauth2 import service_account
from googleapiclient.discovery import build
from googleapiclient.errors import HttpError
from googleapiclient.http import MediaIoBaseUpload

from guest_management.core.config import settings
from guest_management.database import get_db


load_dotenv()

logger = logging.getLogger(__name__)


# ======================================================================
# CONSTANTS
# ======================================================================

SCOPES = [
    "https://www.googleapis.com/auth/drive",
]


GOOGLE_TOKEN_URI = "https://oauth2.googleapis.com/token"


# ======================================================================
# ENCRYPTION
# ======================================================================

def _fernet() -> Fernet:
    """
    Build the Fernet key from SESSION_SECRET.

    This must remain identical to the encryption mechanism used when
    google_refresh_token_enc was originally stored.
    """

    key = base64.urlsafe_b64encode(
        hashlib.sha256(
            settings.session_secret.encode()
        ).digest()
    )

    return Fernet(key)


def encrypt_refresh_token(token: str) -> str:
    """
    Encrypt a Google OAuth refresh token for database storage.
    """

    token = str(token or "").strip()

    if not token:
        raise ValueError(
            "Google refresh token cannot be empty."
        )

    return _fernet().encrypt(
        token.encode()
    ).decode()


def decrypt_refresh_token(token: str) -> str:
    """
    Decrypt a Google OAuth refresh token stored in the database.
    """

    token = str(token or "").strip()

    if not token:
        raise ValueError(
            "Encrypted Google refresh token cannot be empty."
        )

    return _fernet().decrypt(
        token.encode()
    ).decode()


# ======================================================================
# SERVICE
# ======================================================================

class GoogleDriveService:
    """
    Google Drive service for one authenticated EventLah user.

    Example:

        drive = GoogleDriveService(
            user_id="abc123"
        )

        root = drive.ensure_root_folder()

        file_id = drive.upload_bytes(
            filename="logo.png",
            content=data,
            mime_type="image/png",
            parent_id=root,
        )
    """

    def __init__(
        self,
        user_id: str,
        *,
        root_folder_id: Optional[str] = None,
    ) -> None:

        user_id = str(user_id or "").strip()

        if not user_id:
            raise ValueError(
                "user_id is required for Google Drive service."
            )

        self.user_id = user_id

        self.root_folder_id = (
            root_folder_id
            or getattr(
                settings,
                "google_drive_root_folder_id",
                "",
            )
            or os.getenv(
                "GOOGLE_DRIVE_ROOT_FOLDER_ID",
                "",
            )
        ).strip()

        self._drive = None

    # ==================================================================
    # AUTHENTICATION
    # ==================================================================

    def _database_credentials(self):
        """
        Build Google OAuth credentials from the encrypted refresh token
        stored for this EventLah user.
        """

        rows = (
            get_db()
            .table("users")
            .select(
                "google_refresh_token_enc"
            )
            .eq(
                "id",
                self.user_id,
            )
            .limit(1)
            .execute()
            .data
        )

        if not rows:
            raise RuntimeError(
                "EventLah user was not found."
            )

        encrypted_token = (
            rows[0].get(
                "google_refresh_token_enc"
            )
        )

        if not encrypted_token:
            raise RuntimeError(
                "Google Drive permission is not connected "
                "for this account."
            )

        refresh_token = decrypt_refresh_token(
            encrypted_token
        )

        if not settings.google_client_id:
            raise RuntimeError(
                "GOOGLE_CLIENT_ID is not configured."
            )

        if not settings.google_client_secret:
            raise RuntimeError(
                "GOOGLE_CLIENT_SECRET is not configured."
            )

        return oauth_credentials.Credentials(
            token=None,
            refresh_token=refresh_token,
            token_uri=GOOGLE_TOKEN_URI,
            client_id=settings.google_client_id,
            client_secret=settings.google_client_secret,
            scopes=SCOPES,
        )

    # ------------------------------------------------------------------

    def _get_database_drive(self):
        """
        Authenticate using the user's database OAuth refresh token.
        """

        creds = self._database_credentials()

        if not creds.valid:
            creds.refresh(Request())

        if not creds.valid:
            raise RuntimeError(
                "Google OAuth credentials could not be refreshed."
            )

        drive = build(
            "drive",
            "v3",
            credentials=creds,
            cache_discovery=False,
        )

        logger.info(
            "Google Drive authenticated using database OAuth "
            "credentials for user %s.",
            self.user_id,
        )

        return drive

    # ------------------------------------------------------------------

    def _get_local_oauth_drive(self):
        """
        Legacy local OAuth token authentication.

        This exists only for backwards compatibility with older
        development environments.
        """

        oauth_token_file = (
            os.getenv(
                "GOOGLE_DRIVE_OAUTH_TOKEN_FILE",
                "",
            )
            .strip()
        )

        if not oauth_token_file:
            return None

        token_path = Path(
            oauth_token_file
        )

        if not token_path.is_absolute():
            token_path = Path.cwd() / token_path

        if not token_path.exists():
            return None

        creds = (
            oauth_credentials.Credentials
            .from_authorized_user_file(
                str(token_path),
                SCOPES,
            )
        )

        if creds.expired and creds.refresh_token:
            creds.refresh(Request())

            try:
                token_path.write_text(
                    creds.to_json(),
                    encoding="utf-8",
                )
            except OSError:
                logger.warning(
                    "Unable to update local Google OAuth token file.",
                    exc_info=True,
                )

        if not creds.valid:
            return None

        logger.warning(
            "Google Drive authenticated using legacy "
            "local OAuth token file."
        )

        return build(
            "drive",
            "v3",
            credentials=creds,
            cache_discovery=False,
        )

    # ------------------------------------------------------------------

    def _get_service_account_drive(self):
        """
        Legacy service-account authentication.

        Retained for compatibility with existing deployments.
        """

        service_account_file = (
            os.getenv(
                "GOOGLE_DRIVE_SERVICE_ACCOUNT_FILE",
                "",
            )
            .strip()
        )

        if service_account_file:

            path = Path(
                service_account_file
            )

            if not path.is_absolute():
                path = Path.cwd() / path

            if path.exists():

                creds = (
                    service_account
                    .Credentials
                    .from_service_account_file(
                        str(path),
                        scopes=SCOPES,
                    )
                )

                logger.warning(
                    "Google Drive authenticated using "
                    "service-account fallback."
                )

                return build(
                    "drive",
                    "v3",
                    credentials=creds,
                    cache_discovery=False,
                )

        # --------------------------------------------------------------
        # Environment JSON fallback
        # --------------------------------------------------------------

        service_account_json = (
            os.getenv(
                "GOOGLE_DRIVE_SERVICE_ACCOUNT_JSON",
                "",
            )
            .strip()
        )

        if service_account_json:

            info = json.loads(
                service_account_json
            )

            creds = (
                service_account
                .Credentials
                .from_service_account_info(
                    info,
                    scopes=SCOPES,
                )
            )

            logger.warning(
                "Google Drive authenticated using "
                "service-account environment configuration."
            )

            return build(
                "drive",
                "v3",
                credentials=creds,
                cache_discovery=False,
            )

        return None

    # ------------------------------------------------------------------

    def _get_drive(self):
        """
        Return an authenticated Google Drive API client.

        Authentication priority:

            1. Database OAuth
            2. Local OAuth token
            3. Service account
        """

        if self._drive is not None:
            return self._drive

        # --------------------------------------------------------------
        # 1. Database OAuth
        # --------------------------------------------------------------

        try:

            self._drive = (
                self._get_database_drive()
            )

            return self._drive

        except Exception as exc:

            logger.error(
                "Database Google Drive OAuth authentication "
                "failed for user %s: %s",
                self.user_id,
                exc,
            )

        # --------------------------------------------------------------
        # 2. Legacy local OAuth
        # --------------------------------------------------------------

        try:

            self._drive = (
                self._get_local_oauth_drive()
            )

            if self._drive is not None:
                return self._drive

        except Exception:

            logger.exception(
                "Legacy Google Drive OAuth authentication failed."
            )

        # --------------------------------------------------------------
        # 3. Service account fallback
        # --------------------------------------------------------------

        try:

            self._drive = (
                self._get_service_account_drive()
            )

            if self._drive is not None:
                return self._drive

        except Exception:

            logger.exception(
                "Google Drive service-account authentication failed."
            )

        raise RuntimeError(
            "Unable to authenticate with Google Drive. "
            "Connect Google Drive permission for this account."
        )

    # ==================================================================
    # ACCOUNT INFORMATION
    # ==================================================================

    def get_account_info(self) -> Dict[str, Any]:
        """
        Return information about the authenticated Google account.
        """

        drive = self._get_drive()

        result = (
            drive.about()
            .get(
                fields=(
                    "user("
                    "displayName,"
                    "emailAddress,"
                    "permissionId"
                    ")"
                )
            )
            .execute()
        )

        return result.get(
            "user",
            {},
        )

    # ==================================================================
    # ROOT FOLDER
    # ==================================================================

    def ensure_root_folder(self) -> str:
        """
        Ensure the EventLah root folder exists.

        If GOOGLE_DRIVE_ROOT_FOLDER_ID is configured, that folder is
        used directly.

        Otherwise an EventLah folder is created in the user's Drive.
        """

        drive = self._get_drive()

        # --------------------------------------------------------------
        # Configured root folder
        # --------------------------------------------------------------

        if self.root_folder_id:

            try:

                drive.files().get(
                    fileId=self.root_folder_id,
                    fields="id,name,mimeType,trashed",
                ).execute()

                return self.root_folder_id

            except HttpError:

                logger.warning(
                    "Configured Google Drive root folder %s "
                    "could not be accessed.",
                    self.root_folder_id,
                )

        # --------------------------------------------------------------
        # Find existing EventLah folder
        # --------------------------------------------------------------

        query = (
            "name = 'EventLah' "
            "and mimeType = "
            "'application/vnd.google-apps.folder' "
            "and trashed = false"
        )

        result = (
            drive.files()
            .list(
                q=query,
                spaces="drive",
                fields="files(id,name)",
                pageSize=1,
            )
            .execute()
        )

        files = result.get(
            "files",
            [],
        )

        if files:
            self.root_folder_id = files[0]["id"]
            return self.root_folder_id

        # --------------------------------------------------------------
        # Create root folder
        # --------------------------------------------------------------

        result = (
            drive.files()
            .create(
                body={
                    "name": "EventLah",
                    "mimeType": (
                        "application/vnd.google-apps.folder"
                    ),
                },
                fields="id",
            )
            .execute()
        )

        self.root_folder_id = result["id"]

        logger.info(
            "Created Google Drive EventLah root folder: %s",
            self.root_folder_id,
        )

        return self.root_folder_id

    # ==================================================================
    # UPLOAD
    # ==================================================================

    def upload_bytes(
        self,
        filename: str,
        content: bytes,
        mime_type: str,
        parent_id: Optional[str] = None,
    ) -> str:
        """
        Upload bytes to Google Drive.

        Returns:
            Google Drive file ID.
        """

        filename = (
            str(filename or "")
            .strip()
        )

        if not filename:
            raise ValueError(
                "filename is required"
            )

        if content is None:
            raise ValueError(
                "content cannot be None"
            )

        if not isinstance(
            content,
            bytes,
        ):
            raise TypeError(
                "content must be bytes"
            )

        mime_type = (
            str(mime_type or "")
            .strip()
            or "application/octet-stream"
        )

        drive = self._get_drive()

        parent_id = (
            parent_id
            or self.root_folder_id
            or self.ensure_root_folder()
        )

        media = MediaIoBaseUpload(
            io.BytesIO(content),
            mimetype=mime_type,
            resumable=False,
        )

        result = (
            drive.files()
            .create(
                body={
                    "name": filename,
                    "parents": [parent_id],
                },
                media_body=media,
                fields="id,name,mimeType,webViewLink",
            )
            .execute()
        )

        logger.info(
            "Uploaded Google Drive file '%s' (%s) for user %s.",
            filename,
            result.get("id"),
            self.user_id,
        )

        return result["id"]

    # ==================================================================
    # HEALTH CHECK
    # ==================================================================

    def health_check(self) -> bool:
        """
        Verify Google Drive authentication and access.
        """

        try:

            account = self.get_account_info()

            logger.info(
                "Google Drive health check OK: %s",
                account.get(
                    "emailAddress",
                    "unknown",
                ),
            )

            return True

        except Exception:

            logger.exception(
                "Google Drive health check failed."
            )

            return False