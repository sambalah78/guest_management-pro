# EventLah environment configuration example
#
# Copy this file to .env for local development.
# Never commit real credentials or production secrets.
#
# Generate strong secrets with:
# python -c "import secrets; print(secrets.token_urlsafe(64))"

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------

ENVIRONMENT=development
APP_URL=http://localhost:3000

# Local development can use SQLite.
# Production should use the PostgreSQL/Supabase DATABASE_URL.
DATABASE_URL=sqlite:///./guest_management.db

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------

QR_SECRET=replace-with-a-long-random-secret
SESSION_SECRET=replace-with-a-different-long-random-secret

# Must be URL-safe Base64 and decode to exactly 32 bytes.
# This example is NOT a production secret.
SESSION_ENCRYPTION_KEY=MDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDA=

# Required for scanner station authentication.
SCANNER_STATION_SECRET=replace-with-a-long-random-secret

# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SECRET_KEY=

# Used only by the read-only production authentication smoke test.
# Do not expose this key to the browser or client-side code.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Google OAuth / Google Drive
# ---------------------------------------------------------------------------

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# Optional depending on the configured Google Drive workflow.
GOOGLE_DRIVE_ROOT_FOLDER_ID=

# ---------------------------------------------------------------------------
# Email
# ---------------------------------------------------------------------------

EMAIL_PROVIDER=gmail

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SENDER_EMAIL=

EMAIL_WORKER_BATCH_SIZE=50
EMAIL_WORKER_INTERVAL_SECONDS=2
EMAIL_MAX_ATTEMPTS=5

# ---------------------------------------------------------------------------
# QR compatibility
# ---------------------------------------------------------------------------

# Must remain false in production.
ALLOW_LEGACY_QR=false

# ---------------------------------------------------------------------------
# Session
# ---------------------------------------------------------------------------

SESSION_TTL_SECONDS=28800
