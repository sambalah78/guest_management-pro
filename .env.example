# Local development defaults
ENVIRONMENT=development
APP_URL=http://localhost:3000
DATABASE_URL=sqlite:///./guest_management.db

# Google OAuth (create a Web application client in Google Cloud)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# Google Drive uses the same Google OAuth grant (drive.file scope)
GOOGLE_DRIVE_ROOT_FOLDER_ID=

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
QR_SECRET=change-this-to-a-long-random-secret
SESSION_SECRET=change-this-to-a-different-long-random-secret

# Email (optional for local development; required in production)
SENDGRID_API_KEY=
SENDER_EMAIL=
EMAIL_WORKER_BATCH_SIZE=50
EMAIL_WORKER_INTERVAL_SECONDS=2
EMAIL_MAX_ATTEMPTS=5
ALLOW_LEGACY_QR=false
